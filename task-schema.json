{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BridgeTask",
  "type": "object",
  "required": ["id", "from", "to", "type", "subject", "payload", "status", "created_at"],
  "properties": {
    "id": { "type": "string", "description": "UUID v4" },
    "from": { "enum": ["claude", "codex"] },
    "to": { "enum": ["claude", "codex"] },
    "type": { "enum": ["task", "review", "question", "handoff", "notify"] },
    "subject": { "type": "string", "maxLength": 200 },
    "payload": { "type": "string" },
    "context": {
      "type": "object",
      "properties": {
        "project": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "selection": { "type": "string" }
      }
    },
    "status": { "enum": ["pending", "accepted", "running", "done", "rejected"] },
    "result": { "type": "string" },
    "reply_to": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
